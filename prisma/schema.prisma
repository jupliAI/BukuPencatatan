// Prisma schema for Blockchain Transaction Ledger
// Phase 2: Core Domain & Audit Outbox

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  VENDOR
  PROCUREMENT_OFFICER
  PPK
  FINANCE
  AUTHORIZED_OFFICER
  PAYMENT_SYSTEM
  AUDITOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

enum VendorStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum POStatus {
  DRAFT
  ISSUED
  PARTIALLY_RECEIVED
  RECEIVED
  VERIFIED
  CANCELLED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  CONFIRMED
  FAILED
}

enum BlockchainTxStatus {
  SUBMITTED
  CONFIRMED
  FAILED
}

model Organization {
  id            String             @id @default(uuid())
  name          String
  code          String             @unique
  address       String?
  contact_email String?
  status        OrganizationStatus @default(ACTIVE)
  created_at    DateTime           @default(now())
  updated_at    DateTime           @updatedAt

  users           User[]
  vendors         Vendor[]
  purchase_orders PurchaseOrder[]

  @@map("organizations")
}

model User {
  id                 String     @id @default(uuid())
  name               String
  email              String     @unique
  password_hash      String
  role               Role
  organization_id    String
  status             UserStatus @default(ACTIVE)
  refresh_token_hash String?
  created_at         DateTime   @default(now())
  updated_at         DateTime   @updatedAt

  organization       Organization    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  purchase_orders    PurchaseOrder[] @relation("POCreator")
  uploaded_documents Document[]

  @@index([organization_id])
  @@map("users")
}

model Vendor {
  id              String       @id @default(uuid())
  vendor_code     String
  legal_name      String
  tax_id          String
  address         String
  contact_email   String
  organization_id String
  status          VendorStatus @default(ACTIVE)
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  organization    Organization    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  purchase_orders PurchaseOrder[]

  @@unique([organization_id, vendor_code])
  @@index([organization_id])
  @@map("vendors")
}

model PurchaseOrder {
  id                    String   @id @default(uuid())
  po_number             String
  vendor_id             String
  buyer_organization_id String
  description           String
  total_amount          Decimal  @db.Decimal(20, 2)
  currency              String   @default("IDR")
  issue_date            DateTime?
  due_date              DateTime
  status                POStatus @default(DRAFT)
  blockchain_status     String   @default("PENDING")
  created_by            String
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  vendor             Vendor              @relation(fields: [vendor_id], references: [id])
  buyer_organization Organization        @relation(fields: [buyer_organization_id], references: [id])
  creator            User                @relation("POCreator", fields: [created_by], references: [id])
  items              PurchaseOrderItem[]

  @@unique([buyer_organization_id, po_number])
  @@index([buyer_organization_id])
  @@index([vendor_id])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id          String   @id @default(uuid())
  po_id       String
  description String
  quantity    Decimal  @db.Decimal(12, 2)
  unit_price  Decimal  @db.Decimal(20, 2)
  total_price Decimal  @db.Decimal(20, 2)
  created_at  DateTime @default(now())

  purchase_order PurchaseOrder @relation(fields: [po_id], references: [id], onDelete: Cascade)

  @@index([po_id])
  @@map("purchase_order_items")
}

model Document {
  id                String   @id @default(uuid())
  entity_id         String
  entity_type       String
  filename          String
  original_filename String
  mime_type         String
  file_path         String
  sha256_hash       String
  uploaded_by       String
  uploaded_at       DateTime @default(now())

  uploader User @relation(fields: [uploaded_by], references: [id])

  @@index([entity_id, entity_type])
  @@map("documents")
}

model ApplicationEvent {
  id              String       @id @default(uuid())
  event_type      String
  entity_id       String
  entity_type     String
  actor_id        String?
  organization_id String?
  payload         Json
  status          OutboxStatus @default(PENDING)
  attempt_count   Int          @default(0)
  last_error      String?
  created_at      DateTime     @default(now())
  processed_at    DateTime?

  blockchain_transactions BlockchainTransaction[]

  @@index([status, created_at])
  @@index([entity_id, entity_type])
  @@map("application_events")
}

model BlockchainTransaction {
  id                   String             @id @default(uuid())
  application_event_id String
  transaction_id       String             @unique
  event_type           String
  entity_id            String
  entity_type          String
  status               BlockchainTxStatus @default(CONFIRMED)
  error_message        String?
  submitted_at         DateTime           @default(now())
  confirmed_at         DateTime?

  application_event ApplicationEvent @relation(fields: [application_event_id], references: [id], onDelete: Cascade)

  @@index([application_event_id])
  @@index([entity_id])
  @@map("blockchain_transactions")
}
