# Development Environment Configuration

# Database — Neon Postgres (serverless). Kosongkan/nonaktifkan untuk mode in-memory.
# DATABASE_URL  : host ber-akhiran "-pooler" → dipakai aplikasi (wajib di serverless).
# DIRECT_URL    : host tanpa "-pooler"      → dipakai tooling migrasi/DDL.
# Driver yang dipakai: @neondatabase/serverless (SQL over HTTP).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Application Server
PORT=3000
NODE_ENV="development"

# Authentication & Security
JWT_SECRET="dev_jwt_secret_change_in_production_min32chars"
JWT_REFRESH_SECRET="dev_jwt_refresh_secret_change_in_production_min32chars"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Blockchain Integration Provider (mock or fabric)
BLOCKCHAIN_PROVIDER="mock"
BLOCKCHAIN_MODE="mock"

# Hyperledger Fabric Gateway Configuration (Phase 3)
FABRIC_ENABLED="false"
FABRIC_CHANNEL="procurementchannel"
FABRIC_CHAINCODE="procurement-ledger"
FABRIC_MSP_ID="ProcurementMSP"
FABRIC_PEER_ENDPOINT="localhost:7051"
FABRIC_GATEWAY_ENDPOINT="localhost:7051"
FABRIC_PEER_HOST_OVERRIDE="peer0.procurement.example.com"
FABRIC_CERT_PATH="./blockchain/fabric-network/crypto-material/peerOrganizations/procurement.example.com/users/app-client/msp/signcerts/cert.pem"
FABRIC_KEY_PATH="./blockchain/fabric-network/crypto-material/peerOrganizations/procurement.example.com/users/app-client/msp/keystore/priv_sk"
FABRIC_TLS_CERT_PATH="./blockchain/fabric-network/crypto-material/peerOrganizations/procurement.example.com/peers/peer0.procurement.example.com/tls/ca.crt"

# Fabric Bridge (WAJIB untuk deployment serverless seperti Vercel).
# Fabric Gateway butuh koneksi gRPC persisten + file cert, yang tidak tersedia di
# runtime serverless. Karena itu bridge dijalankan sebagai proses terpisah di VPS
# (lihat blockchain/fabric-bridge/), dan aplikasi memanggilnya via HTTPS.
# Aktifkan dengan: BLOCKCHAIN_PROVIDER="remote"
FABRIC_BRIDGE_URL=""
FABRIC_BRIDGE_TOKEN=""
FABRIC_BRIDGE_TIMEOUT_MS=15000

# Outbox Worker Configuration
OUTBOX_POLL_INTERVAL_MS=3000
OUTBOX_BATCH_SIZE=10
OUTBOX_MAX_RETRIES=5

# Secret untuk endpoint /api/cron/outbox (pengganti setInterval di serverless).
# Di Vercel, cron otomatis mengirim header `Authorization: Bearer $CRON_SECRET`.
# Kosongkan untuk menonaktifkan pemeriksaan (hanya boleh di development).
CRON_SECRET=""

# -------------------------------------------------------------------
# GATEWAY ↔ SWITCHING INTEGRATION (DECISION REQUIRED with Gateway team)
# -------------------------------------------------------------------
# Catatan keamanan: shared secret di bawah ini HARUS dirotasi dan disimpan
# di secret manager (bukan hardcode) pada tahap production.

# 1. INBOUND (Gateway → Switching POST /api/v1/webhooks/gateway)
#    Shared secret untuk HMAC-SHA256 signature verification.
#    Format signature: HMAC(secret, timestamp + "." + rawBody)
#    Header yang dikirim Gateway: X-Gateway-Signature, X-Gateway-Timestamp, X-Api-Key
GATEWAY_WEBHOOK_SHARED_SECRET="dev_gateway_shared_secret_min_32chars_xxxxxxxxxxxxxxxx"
GATEWAY_WEBHOOK_API_KEY="dev_gateway_webhook_api_key_xxxxxxxxxxxxxxxxxxxxxxxx"
# Replay protection: tolak webhook dengan timestamp lebih tua dari angka ini (ms).
# Toleransi 5 menit (300.000 ms) — default jika tidak diset.
GATEWAY_WEBHOOK_TOLERANCE_MS=300000

# 2. OUTBOUND (Switching → Gateway, misal POST /gateway/v1/transactions/submit)
#    Switching sebagai klien memanggil endpoint Gateway.
#    API key dan shared secret ini bisa SAMA ATAU BERBEDA dengan inbound —
#    tergantung kesepakatan dengan tim Gateway.
GATEWAY_OUTBOUND_API_KEY="dev_switching_client_api_key_xxxxxxxxxxxxxxxxxxxxxxxx"
GATEWAY_OUTBOUND_SHARED_SECRET="dev_switching_outbound_shared_secret_min_32chars_xxxx"
GATEWAY_BASE_URL="https://gateway.example.local/v1"

# 3. Retry / Timeout policy (sesuai angka berjalan Switching)
#    Batas tunggu HTTP call ke Gateway sebelum dianggap timeout dan retry.
GATEWAY_TIMEOUT_MS=10000
#    Base backoff untuk retry job: attempt ke-N = N * RETRY_BACKOFF_BASE_MS (ms)
RETRY_BACKOFF_BASE_MS=5000
#    Maksimal percobaan retry sebelum ditandai FAILED permanen.
RETRY_MAX_ATTEMPTS=5
#    Transaksi PENDING lebih tua dari ini dianggap macet dan perlu dicek manual.
TRANSACTION_PENDING_TIMEOUT_MS=60000
#    Header naming convention untuk signature outgoing:
#    - "switching-prefixed" (default): X-Switching-Signature, X-Switching-Timestamp
#    - "gateway-prefixed"          : X-Gateway-Signature, X-Gateway-Timestamp
GATEWAY_OUTBOUND_HEADER_CONVENTION="switching-prefixed"

# -------------------------------------------------------------------
# SWITCHING HUB INTEGRATION (BukuPencatatan → Switching Partner API)
# Credential didaftarkan di SwSwitching UI → Partners → "Create Partner" → "Issue Credential".
# X-Api-Secret HANYA DITAMPILKAN SEKALI saat issuance (disimpan sebagai bcrypt hash di Switching,
# tidak bisa di retrieve kembali — catat di secret manager saat create).
# -------------------------------------------------------------------
SWITCHING_BASE_URL="http://localhost:3000"
SWITCHING_API_KEY="dsk_xxxxx_switching_partner_api_key"
SWITCHING_API_SECRET="secret_shown_only_once_at_credential_issuance_save_me"
# (Optional) Shared secret untuk layer-2 HMAC signing — harus sama dengan yang didaftarkan di tim Switching.
SWITCHING_SHARED_SECRET=""
# Timeout setiap call ke Switching; default 10 detik.
SWITCHING_TIMEOUT_MS=10000
# Header convention untuk request signing ke Switching; default switching-prefixed.
SWITCHING_HEADER_CONVENTION="switching-prefixed"
