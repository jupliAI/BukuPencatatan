# -------------------------------------------------------------------
# FABRIC BRIDGE SERVICE — konfigurasi (dijalankan di VPS/Docker)
# Salin file ini menjadi .env lalu sesuaikan nilainya.
# -------------------------------------------------------------------

# HTTP server bridge
BRIDGE_HOST="0.0.0.0"
BRIDGE_PORT=8080
# Token wajib. Vercel akan mengirim header: Authorization: Bearer <token>
# Buat dengan: openssl rand -hex 32
BRIDGE_TOKEN=""
# Aktifkan HTTPS langsung dari bridge (opsional). Bila dikosongkan, bridge berjalan
# sebagai HTTP biasa dan sebaiknya di-proxy oleh Caddy/nginx yang menangani TLS.
# BRIDGE_TLS_CERT="/etc/letsencrypt/live/bridge.example.com/fullchain.pem"
# BRIDGE_TLS_KEY="/etc/letsencrypt/live/bridge.example.com/privkey.pem"

# -------------------------------------------------------------------
# Koneksi ke Hyperledger Fabric
#
# Nilai di bawah ini cocok dengan fabric-samples "test-network" (org1).
# Cara termudah: jalankan scripts/bringup-test-network.sh — script itu
# mengisi seluruh variabel ini secara otomatis.
# -------------------------------------------------------------------
FABRIC_CHANNEL="procurementchannel"
FABRIC_CHAINCODE="procurement-ledger"
FABRIC_MSP_ID="Org1MSP"
# Bila bridge berjalan di host yang sama dengan test-network, peer dipublikasikan
# ke localhost:7051.
FABRIC_PEER_ENDPOINT="localhost:7051"
# Hostname di dalam sertifikat TLS peer — harus cocok agar verifikasi TLS lolos.
FABRIC_PEER_HOST_OVERRIDE="peer0.org1.example.com"

# Material kriptografi. Path ini HARUS dapat dibaca oleh proses bridge.
# Contoh path hasil test-network:
#   ~/fabric/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/users/Admin@org1.example.com/msp/signcerts/...
#   ~/fabric/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/users/Admin@org1.example.com/msp/keystore/...
#   ~/fabric/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/peers/peer0.org1.example.com/tls/ca.crt
#
# Perhatian: nama berkas cert/key berbeda tergantung cara identitas dibuat.
# Mode CA (network.sh ... -ca): signcerts/cert.pem + keystore/<serial>_sk
# Mode cryptogen:               signcerts/<identity>-cert.pem + keystore/priv_sk
FABRIC_CERT_PATH=""
FABRIC_KEY_PATH=""
FABRIC_TLS_CERT_PATH=""
